# EC2 서버에 backend.env 로 복사해서 실제 값을 채우세요. (이 예시 파일에는 실제 값 금지)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
TZ=Asia/Seoul

# RDS
DB_HOST=xxxx.xxxxxx.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=team28
DB_USERNAME=
DB_PASSWORD=

# 프론트 주소 (여러 개면 쉼표로 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<프론트>.vercel.app

# AI 서버 (docker-compose.prod.yml 의 ai 서비스). AI_INTERNAL_KEY 는 ai.env 와 같은 값
AI_ENABLED=true
AI_BASE_URL=http://ai:8000
AI_INTERNAL_KEY=
