# 이 파일을 복사해서 .env 를 만드세요:  cp .env.example .env
# .env 는 절대 Git 에 올리지 않습니다.

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Local MySQL (docker-compose)
MYSQL_DATABASE=team28
MYSQL_USER=team28
MYSQL_PASSWORD=team28pw
MYSQL_ROOT_PASSWORD=root1234
TZ=Asia/Seoul

# CORS (프론트 주소, 여러 개면 쉼표로 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI 서버 (2026_GANZITHON_TEAM_28_AI). AI_ENABLED=false 면 AI 서버 없이 임시 문장으로 동작
AI_ENABLED=true
AI_BASE_URL=http://localhost:8000
AI_INTERNAL_KEY=
